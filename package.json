{
  "name": "magpie",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @magpie/server --filter @magpie/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @magpie/server db:migrate",
    "db:seed-dev": "pnpm --filter @magpie/server db:seed-dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
